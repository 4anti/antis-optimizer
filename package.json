{
  "name": "antis-optimizer",
  "version": "1.5.0",
  "description": "Stop AI coding agents from wasting tokens on junk & huge files. Audits repo bloat, syncs ignores across AI tools, and slices exact function/section lines (--audit, --detect, --sync-ignores, --sync-landmarks, --map, --slice, --outline, --handoff, --verify).",
  "bin": {
    "antis-optimizer": "scripts/repo-index.cjs"
  },
  "main": "./scripts/repo-index.cjs",
  "files": [
    "scripts/repo-index.cjs",
    "SKILL.md",
    "references/tool-coop-matrix.md",
    "references/templates.md",
    "assets/*.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node ./test/test-suite.cjs",
    "accuracy": "node ./test/accuracy.cjs",
    "audit": "node ./scripts/repo-index.cjs --audit",
    "detect": "node ./scripts/repo-index.cjs --detect",
    "sync-ignores": "node ./scripts/repo-index.cjs --sync-ignores --write",
    "sync-landmarks": "node ./scripts/repo-index.cjs --sync-landmarks --write",
    "verify": "node ./scripts/repo-index.cjs --verify"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "cursor",
    "codex",
    "antigravity",
    "context-window",
    "token-optimization",
    "ast",
    "mcp",
    "jcodemunch",
    "ponytail",
    "caveman",
    "ripgrep",
    "llm-tools"
  ],
  "author": "4anti",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4anti/antis-optimizer.git"
  },
  "bugs": {
    "url": "https://github.com/4anti/antis-optimizer/issues"
  },
  "homepage": "https://github.com/4anti/antis-optimizer#readme"
}
